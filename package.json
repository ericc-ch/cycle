{
  "name": "cycle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "nub run --filter @cycle/web dev",
    "build": "nub run --filter @cycle/web build",
    "preview": "nub run --filter @cycle/web preview",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "lint": "oxlint apps packages && effect-tsgo patch --no-typescript --oxlint && oxlint --config .oxlintrc.effect.json --deny-warnings apps packages",
    "check": "nub run typecheck && nub run test && nub run lint && nub run build",
    "score": "nub packages/domain/src/scoring/score.ts",
    "dataset": "nub packages/domain/scripts/fetch-dataset.ts"
  },
  "devDependencies": {
    "@effect/tsgo": "0.50.0",
    "@foldkit/oxlint-plugin": "0.15.4",
    "@stylexjs/unplugin": "^0.19.0",
    "@types/node": "^24.10.1",
    "effect": "4.1.0",
    "foldkit": "0.170.0",
    "happy-dom": "^20.14.5",
    "oxfmt": "^0.66.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.9.7",
      "onFail": "ignore"
    }
  }
}
